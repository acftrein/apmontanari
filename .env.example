# Copie este arquivo para ".env" (nao versionado) e preencha com os valores reais.
# NUNCA faça commit do arquivo ".env" real.

# Chave usada pelo Flask para assinar sessões/cookies. Gere uma nova com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Conta do Gmail usada para envio de relatórios
MAIL_USERNAME=acftrein@gmail.com
# Senha de APP do Gmail (não é a senha normal da conta). Gere em:
# https://myaccount.google.com/apppasswords
MAIL_PASSWORD=

# Lista de destinatários do relatório, separados por vírgula
REPORT_RECIPIENTS=acftrein@gmail.com
